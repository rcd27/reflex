FROM rust:1.87-alpine3.21 AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY linux/ linux/

RUN cargo build --release --examples

FROM alpine:3.21

RUN apk add --no-cache \
    iproute2 \
    bridge-utils \
    tcpdump \
    curl \
    openssl \
    nginx \
    iputils \
    bash

# self-signed cert for test TLS server
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 3650 \
    -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/server.key \
    -out /etc/nginx/ssl/server.crt \
    -subj "/CN=testserver.local"

COPY --from=builder /build/target/release/examples/e2e_capture /usr/local/bin/e2e_capture
COPY linux/tests/e2e/nginx.conf /etc/nginx/nginx.conf
COPY linux/tests/e2e/setup-topology.sh /usr/local/bin/setup-topology.sh
RUN chmod +x /usr/local/bin/setup-topology.sh

CMD ["/usr/local/bin/setup-topology.sh"]
