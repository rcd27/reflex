FROM rust:1.87-alpine3.21 AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY linux/ linux/
COPY linux-common/ linux-common/
COPY examples/ examples/

RUN cargo build --release

# --- eBPF builder: nightly + bpf-linker (Debian for LLVM compat) ---
FROM rust:1.87-bookworm AS ebpf-builder

RUN rustup toolchain install nightly --component rust-src
RUN cargo +nightly install bpf-linker

WORKDIR /build
COPY linux-ebpf/ linux-ebpf/
COPY linux-common/ linux-common/

# compile eBPF program to BPF bytecode
RUN cd linux-ebpf && \
    cargo +nightly build \
    --release \
    --target bpfel-unknown-none \
    -Z build-std=core

# --- runtime ---
FROM alpine:3.21

RUN apk add --no-cache \
    iproute2 \
    bridge-utils \
    tcpdump \
    curl \
    openssl \
    nginx \
    iputils \
    bash

# self-signed cert for test TLS server
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 3650 \
    -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/server.key \
    -out /etc/nginx/ssl/server.crt \
    -subj "/CN=testserver.local"

# userspace binaries
COPY --from=builder /build/target/release/e2e_capture /usr/local/bin/e2e_capture
COPY --from=builder /build/target/release/e2e_rst_emulator /usr/local/bin/e2e_rst_emulator
COPY --from=builder /build/target/release/e2e_rst_detector /usr/local/bin/e2e_rst_detector
COPY --from=builder /build/target/release/e2e_multi_disorder /usr/local/bin/e2e_multi_disorder
COPY --from=builder /build/target/release/e2e_feedback_loop /usr/local/bin/e2e_feedback_loop

# eBPF bytecode
COPY --from=ebpf-builder /build/linux-ebpf/target/bpfel-unknown-none/release/reflex-xdp /usr/local/lib/reflex-xdp.o

COPY linux/tests/e2e/nginx.conf /etc/nginx/nginx.conf
COPY linux/tests/e2e/setup-topology.sh /usr/local/bin/setup-topology.sh
RUN chmod +x /usr/local/bin/setup-topology.sh

CMD ["/usr/local/bin/setup-topology.sh"]
