FROM rust:1.87-alpine3.21 AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY linux/ linux/
COPY linux-common/ linux-common/
COPY examples/ examples/

# build all AF_PACKET binaries + XDP-enabled geneva
RUN cargo build --release
RUN cargo build --release -p example-rst-injection --features tc --bin e2e_geneva_tc

# --- eBPF builder ---
FROM rust:1.87-bookworm AS ebpf-builder

RUN rustup toolchain install nightly --component rust-src
RUN cargo +nightly install bpf-linker

WORKDIR /build
COPY linux-ebpf/ linux-ebpf/
COPY linux-common/ linux-common/

RUN cd linux-ebpf && \
    cargo +nightly build \
    --release \
    --target bpfel-unknown-none \
    -Z build-std=core

# --- runtime ---
FROM alpine:3.21

RUN apk add --no-cache \
    iproute2 \
    iptables \
    tcpdump \
    curl \
    iputils \
    bash

COPY --from=builder /build/target/release/e2e_capture /usr/local/bin/e2e_capture
COPY --from=builder /build/target/release/e2e_rst_detector /usr/local/bin/e2e_rst_detector
COPY --from=builder /build/target/release/e2e_geneva_live /usr/local/bin/e2e_geneva_live
COPY --from=builder /build/target/release/e2e_geneva_tc /usr/local/bin/e2e_geneva_tc
COPY --from=ebpf-builder /build/linux-ebpf/target/bpfel-unknown-none/release/reflex-xdp /usr/local/lib/reflex-xdp.o
COPY linux/tests/e2e/setup-live.sh /usr/local/bin/setup-live.sh
RUN chmod +x /usr/local/bin/setup-live.sh

CMD ["/usr/local/bin/setup-live.sh"]
