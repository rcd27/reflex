FROM rust:1.87-alpine3.21 AS builder

RUN apk add --no-cache musl-dev libnetfilter_queue-dev

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY linux/ linux/
COPY linux-common/ linux-common/
COPY examples/ examples/

RUN cargo build --release --features nfqueue

FROM alpine:3.21

RUN apk add --no-cache \
    iproute2 \
    iptables \
    nftables \
    tcpdump \
    curl \
    iputils \
    bash \
    libnetfilter_queue

COPY --from=builder /build/target/release/e2e_capture /usr/local/bin/e2e_capture
COPY --from=builder /build/target/release/e2e_feedback_loop /usr/local/bin/e2e_feedback_loop
COPY --from=builder /build/target/release/e2e_multi_disorder /usr/local/bin/e2e_multi_disorder
COPY --from=builder /build/target/release/e2e_rst_detector /usr/local/bin/e2e_rst_detector
COPY --from=builder /build/target/release/e2e_rst_emulator /usr/local/bin/e2e_rst_emulator
COPY --from=builder /build/target/release/e2e_geneva_nfq /usr/local/bin/e2e_geneva_nfq
COPY linux/tests/e2e/setup-live.sh /usr/local/bin/setup-live.sh
RUN chmod +x /usr/local/bin/setup-live.sh

CMD ["/usr/local/bin/setup-live.sh"]
