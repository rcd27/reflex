# КЛИЕНТ РАЗГОВОРА — РОЛЬ МИРА, А НЕ ПОДОПЫТНОГО (#326, 05.09.2026).
#
# # Зачем третий образ
#
# У обрыва ДВЕ границы: путь к цели и сторона, породившая разговор. Соседние законы очереди
# обходятся одной, и потому подопытный волен быть заодно отправителем пробы. Здесь так нельзя:
# останься сторона отправителя тем же процессом, что и обрывающий, — «извещение дошло до клиента»
# заверял бы сам обрывающий. Это ровно тот корень, ради снятия которого написан весь модуль
# сертификации: свидетельство выдаёт НЕ ТОТ, КОГО ПРОВЕРЯЮТ.
#
# # Почему не переиспользован образ подопытного
#
# Клиенту нужен `iproute2` — маршрут к цели он направляет ЧЕРЕЗ движок, иначе разговор пройдёт
# мимо очереди по общему L2-сегменту. А в образе подопытного отсутствие `iproute2` есть
# ОТРИЦАТЕЛЬНОЕ СВИДЕТЕЛЬСТВО: раз его там нет, а законы держатся, значит калитка не опирается на
# него тайком. Доставь мы инструмент туда ради чужой роли — свидетельство исчезло бы молча.
#
# Здесь оно не теряется: этот контейнер ничего не утверждает. Он посылает и показывает.

FROM rust:1-slim-trixie AS build
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends pkg-config \
 && rm -rf /var/lib/apt/lists/*

COPY core/ ./core/
COPY runtime/ ./runtime/
COPY linux/ ./linux/
COPY linux-common/ ./linux-common/
COPY os/ ./os/
COPY Cargo.toml Cargo.lock ./

# ТОТ ЖЕ БИНАРЬ, ЧТО У ПОДОПЫТНОГО, и собран из того же дерева: `probe` обязан посылать ровно ту
# датаграмму, которую подопытный ждёт. Вторая реализация пробы разъехалась бы с первой молча.
RUN cargo build --release -p reflex-linux --features certify --example certify

FROM debian:stable-slim
ENV DEBIAN_FRONTEND=noninteractive

# `iproute2` — направить разговор через движок. `tshark` — показать, что пришло обратно.
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 tshark \
 && rm -rf /var/lib/apt/lists/*

# СНИФФЕР ПЕРЕЕЗЖАЕТ С СИСТЕМНОГО ПУТИ — AppArmor цепляет профиль ПО ПУТИ бинаря, а ядро у
# контейнера общее с хозяином. Та же грабля, что у соседнего образа, и та же цена.
RUN cp /usr/bin/dumpcap /usr/local/bin/certify-snif

COPY --from=build /src/target/release/examples/certify /usr/local/bin/certify

CMD ["sleep", "infinity"]
